%% =========================================================================
%  SECTION 7: HELPER FUNCTIONS
% =========================================================================

function AR = area_ratio(M, gam)
    %  Isentropic area ratio [R1 eq. 3-13]
    %    A/A* = (1/M) * [(2/(γ+1)) * (1 + (γ-1)/2 * M²)]^[(γ+1)/(2(γ-1))]
    exp = (gam + 1) / (2 * (gam - 1));
    base = (2 / (gam + 1)) * (1 + (gam - 1) / 2 * M^2);
    AR = (1 / M) * base^exp;
end

function Me = solve_mach(eps_in, gam)
    %  Solve area ratio for supersonic Mach by Newton-Raphson [R1 §3-4]
    Me = 2.0;
    for i = 1:300
        f  = area_ratio(Me, gam) - eps_in;
        df = (area_ratio(Me+1e-7, gam) - area_ratio(Me-1e-7, gam)) / 2e-7;
        dM = f / df;
        Me = max(Me - dM, 1.001);
        if abs(dM) < 1e-11; break; end
    end
end
