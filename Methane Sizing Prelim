for k = 1:length(eps_range)
    Me_k = solve_mach(eps_range(k), gamma);
    Pe_k = Pc * (1 + (gamma-1)/2 * Me_k^2)^(-gamma/(gamma-1));
    Te_k = Tc * (1 + (gamma-1)/2 * Me_k^2)^(-1);
    Ve_k = Me_k * sqrt(gamma * R * Te_k);
    Astar_k = F_vac / (mdot_per_Astar * Ve_k + (Pe_k - Pa) * eps_range(k));
    mdot_k  = mdot_per_Astar * Astar_k;
    Isp_range(k) = F_vac / (mdot_k * g0);
end

